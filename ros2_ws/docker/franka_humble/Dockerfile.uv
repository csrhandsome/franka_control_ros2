# Thin layer on the already-built Humble + franka_ros2 image.
# Rebuilds of this file do not recompile /opt/franka_ros2_ws.
FROM data-collect/franka-ros2-humble:2.5.1

ARG USERNAME=franka

USER root
COPY --from=ghcr.io/astral-sh/uv:0.7.20 /uv /usr/local/bin/uv
COPY --from=ghcr.io/astral-sh/uv:0.7.20 /uvx /usr/local/bin/uvx
RUN mkdir -p /opt/uv /opt/overlay_ws \
    && chown "${USERNAME}:${USERNAME}" /opt/uv /opt/overlay_ws

COPY scripts/uv_env_smoke_test.sh /usr/local/bin/uv-env-smoke-test
RUN chmod 0755 /usr/local/bin/uv-env-smoke-test

USER ${USERNAME}
COPY --chown=${USERNAME}:${USERNAME} python /opt/uv/project

ENV UV_PROJECT=/opt/uv/project \
    UV_PROJECT_ENVIRONMENT=/opt/uv/venv \
    VIRTUAL_ENV=/opt/uv/venv \
    UV_LINK_MODE=copy \
    UV_PYTHON=/usr/bin/python3 \
    PATH="/opt/uv/venv/bin:/usr/local/bin:${PATH}"

WORKDIR /opt/uv/project
RUN uv venv --python /usr/bin/python3 --system-site-packages /opt/uv/venv \
    && uv sync --locked \
    && grep -q 'include-system-site-packages = true' /opt/uv/venv/pyvenv.cfg

WORKDIR /workspace/data_collect
