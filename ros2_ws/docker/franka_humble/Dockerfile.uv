# Thin layer on the already-built Humble + franka_ros2 image.
# Rebuilds of this file do not recompile /opt/franka_ros2_ws.
FROM data-collect/franka-ros2-humble:2.5.1

ARG USERNAME=franka

USER root
COPY --from=ghcr.io/astral-sh/uv:0.7.20 /uv /usr/local/bin/uv
COPY --from=ghcr.io/astral-sh/uv:0.7.20 /uvx /usr/local/bin/uvx
RUN mkdir -p /opt/uv /opt/overlay_ws \
    && chown "${USERNAME}:${USERNAME}" /opt/uv /opt/overlay_ws

COPY scripts/uv_env_smoke_test.sh /usr/local/bin/uv-env-smoke-test
RUN chmod 0755 /usr/local/bin/uv-env-smoke-test

# Persistent Panda/FER driver for robot server protocol 5.
ARG PANDA_DRIVER_COMMIT=6867bde68970104118d04ae853ddded15bf857fb
ARG PANDA_LIBFRANKA_COMMIT=f3b8d775a9c847cab32684c8a316f67867761674
RUN git clone https://github.com/frankarobotics/libfranka.git /opt/panda_libfranka_src \
    && git -C /opt/panda_libfranka_src checkout ${PANDA_LIBFRANKA_COMMIT} \
    && git -C /opt/panda_libfranka_src submodule update --init --recursive \
    && /usr/bin/cmake -S /opt/panda_libfranka_src -B /opt/panda_libfranka_build \
       -DBUILD_TESTS=OFF -DBUILD_EXAMPLES=OFF -DCMAKE_INSTALL_PREFIX=/opt/panda_libfranka \
    && /usr/bin/cmake --build /opt/panda_libfranka_build -j4 \
    && /usr/bin/cmake --install /opt/panda_libfranka_build \
    && git clone https://github.com/LCAS/franka_arm_ros2.git /opt/panda_ws/src/franka_arm_ros2 \
    && git -C /opt/panda_ws/src/franka_arm_ros2 checkout ${PANDA_DRIVER_COMMIT} \
    && source /opt/ros/humble/setup.bash \
    && cd /opt/panda_ws \
    && colcon build --packages-skip franka_moveit_config franka_example_controllers \
       --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
       -DFranka_DIR=/opt/panda_libfranka/lib/cmake/Franka
ENV LD_LIBRARY_PATH=/opt/panda_libfranka/lib
COPY entrypoint-safe.sh /usr/local/bin/franka-entrypoint

USER ${USERNAME}
COPY --chown=${USERNAME}:${USERNAME} python /opt/uv/project

ENV UV_PROJECT=/opt/uv/project \
    UV_PROJECT_ENVIRONMENT=/opt/uv/venv \
    VIRTUAL_ENV=/opt/uv/venv \
    UV_LINK_MODE=copy \
    UV_PYTHON=/usr/bin/python3 \
    PATH="/opt/uv/venv/bin:/usr/local/bin:${PATH}"

WORKDIR /opt/uv/project
RUN uv venv --python /usr/bin/python3 --system-site-packages /opt/uv/venv \
    && uv sync --locked \
    && grep -q 'include-system-site-packages = true' /opt/uv/venv/pyvenv.cfg

WORKDIR /workspace/data_collect
