# Copy this file to .env. It is intentionally ignored by Git.
USER_UID=1000
USER_GID=1000
# Relative to this Compose directory; resolves to the repository root.
PROJECT_ROOT=../../..

# The existing Python controller defaults to this address, but it has not been
# verified in the current physical network state. Replace it if Desk shows another FCI IP.
FRANKA_ROBOT_IP=192.168.1.100
FRANKA_INTERFACE=enp3s0
DH5_SERIAL_DEVICE=/dev/ttyUSB0
ROS_DOMAIN_ID=42
